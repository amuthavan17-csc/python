# --- fest_desk/validator.py --- 
class RegistrationError(Exception): 
    """Raised when a registration line fails format or field validation.""" 
 
 
def is_valid_email(email): 
    if not email or " " in email or email.count("@") != 1: 
        return False 
    local, domain = email.split("@") 
    if not local or len(domain) < 3 or "." not in domain: 
        return False 
    if domain.startswith(".") or domain.endswith(".") or ".." in domain: 
        return False 
    return True 
 
 
def parse_registration(line): 
    parts = [p.strip() for p in line.strip().split(",")] 
    if len(parts) != 5: 
        raise RegistrationError(f"Expected 5 fields, got {len(parts)}") 
    reg_no, name, dept, email, events_raw = parts 
    if not reg_no or not name or not dept: 
        raise RegistrationError("Missing required identity field (reg_no/name/dept)") 
    if not is_valid_email(email): 
        raise RegistrationError(f"Invalid email address: '{email}'") 
    events = [e.strip() for e in events_raw.split(";") if e.strip()] 
