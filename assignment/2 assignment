def evaluate_separate_ifs(units, has_ration, has_senior):
    results = []
    if units <= 100:
        results.append("Full Subsidy")
    if 100 <= units <= 200 and has_ration:  # Overlapping boundary at 100 units
        results.append("Partial Subsidy")
    if units > 200 and has_senior:
        results.append("Senior Subsidy")
    if not results:
        results.append("No Subsidy")
    return results
def evaluate_elif(units, has_ration, has_senior):
    if units <= 100:
        return "Full Subsidy"
    elif 101 <= units <= 200 and has_ration:
        return "Partial Subsidy"
    elif units > 200 and has_senior:
        return "Senior Subsidy"
    else:
        return "No Subsidy"
