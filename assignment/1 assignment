TASK 9: Implement and Test the Calculator (K3 – Apply | 4 Marks) 
from decimal import Decimal, ROUND_HALF_UP 
 
BASE_RATE = Decimal("30.00") 
FAT_STEP_VAL = Decimal("0.40") 
SNF_STEP_VAL = Decimal("0.30") 
 
def validate_entry(litres, fat, snf): 
    if not isinstance(litres, (int, float)) or not isinstance(fat, (int, float)) or not 
isinstance(snf, (int, float)): 
        return False 
    return litres > 0 and (2.0 <= fat <= 7.0) and (6.0 <= snf <= 10.0) 
 
def compute_payout_exact(litres, fat, snf): 
    if not validate_entry(litres, fat, snf): 
        raise ValueError("Invalid milk entry") 
    fat_steps = Decimal(str(round((fat - 3.5) / 0.1))) 
    snf_steps = Decimal(str(round((snf - 8.5) / 0.1))) 
    rate = BASE_RATE + (fat_steps * FAT_STEP_VAL) + (snf_steps * SNF_STEP_VAL) 
    pay = (Decimal(str(litres)) * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) 
    return rate, pay 
 
def run_tests(): 
    # Normal & Boundary cases 
    assert compute_payout_exact(10.0, 3.5, 8.5) == (Decimal("30.00"), Decimal("300.00")) 
    assert compute_payout_exact(8.5, 4.2, 8.7) == (Decimal("33.40"), Decimal("283.90")) 
    assert compute_payout_exact(12.0, 3.1, 8.3) == (Decimal("27.80"), Decimal("333.60")) 
    assert compute_payout_exact(5.0, 2.0, 6.0) == (Decimal("16.50"), Decimal("82.50")) 
    assert compute_payout_exact(5.0, 7.0, 10.0) == (Decimal("48.50"), Decimal("242.50")) 
    # Invalid cases 
    assert not validate_entry(-2.0, 3.5, 8.5) 
    assert not validate_entry(10.0, 1.5, 8.5) 
    assert not validate_entry("ten", 3.5, 8.5) 
    # 5-entry hand-verified batch 
    batch = [(10, 3.5, 8.5), (10, 4.0, 8.5), (10, 3.5, 9.0), (5, 3.0, 8.0), (20, 4.5, 8.8)] 
    total = sum(compute_payout_exact(l, f, s)[1] for l, f, s in batch) 
    assert total == Decimal("1654.50") 
    print("All automated assertions passed!") 
 
if __name__ == "__main__": 
    run_tests() 
 
