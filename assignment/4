def parse_line(line): 
    parts = [p.strip() for p in line.strip().split(",")] 
    try: 
        reg_no, date_str, status = parts  # Raises ValueError if len(parts) != 3 
    except ValueError as err: 
        raise InvalidRecord(f"expected 3 fields, found {len(parts)}") from err 
 
    if status not in ("P", "A"): 
        raise InvalidRecord(f"invalid status '{status}'") 
    return reg_no, date_str, status 
 
 
def process_with_complete_try(path): 
    present = absent = 0 
    errors = [] 
    f = None 
    try: 
        f = open(path, "r", encoding="utf-8") 
        for line_no, line in enumerate(f, start=1): 
            if not line.strip(): 
                continue 
            try: 
                _, _, status = parse_line(line) 
            except InvalidRecord as err: 
                errors.append((line_no, str(err))) 
            else: 
                # Executes ONLY when parse_line succeeded without raising 
                if status == "P": 
                    present += 1 
                else: 
                    absent += 1 
    except (FileNotFoundError, PermissionError, UnicodeDecodeError) as file_err: 
        errors.append((0, f"{type(file_err).__name__}: {file_err}")) 
    finally: 
        # Always executes to guarantee resource release 
        if f is not None and not f.closed: 
            f.close() 
    return present, absent, errors 
 
