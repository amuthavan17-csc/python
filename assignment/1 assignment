C. Adaptation & Revised Implementation (2 Marks) 
from decimal import Decimal, ROUND_HALF_UP 
SEASONAL_RATES = { 
"SUMMER": {"base": Decimal("32.00"), "fat_step": Decimal("0.45"), "snf_step": 
Decimal("0.30")}, 
"REGULAR": {"base": Decimal("30.00"), "fat_step": Decimal("0.40"), "snf_step": 
Decimal("0.30")}, 
} 
BONUS_THRESHOLD = Decimal("500.0") 
BONUS_PER_LITRE = Decimal("0.50") 
def exact_steps(value: float, standard: float) -> Decimal: 
"""Computes 0.1% steps using exact Decimal ROUND_HALF_UP.""" 
def get_season(month: int) -> str: 
"""Returns 'SUMMER' for April-June (4..6), else 'REGULAR'.""" 
return "SUMMER" if 4 <= month <= 6 else "REGULAR" 
    diff = (Decimal(str(value)) - Decimal(str(standard))) / Decimal("0.1") 
    return diff.quantize(Decimal("1"), rounding=ROUND_HALF_UP) 
 
def rate_per_litre_v2(fat: float, snf: float, month: int) -> Decimal: 
    rates = SEASONAL_RATES[get_season(month)] 
    f_steps = exact_steps(fat, 3.5) 
    s_steps = exact_steps(snf, 8.5) 
    rate = rates["base"] + (f_steps * rates["fat_step"]) + (s_steps * rates["snf_step"]) 
    return rate.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) 
 
def ten_day_bonus(total_litres: Decimal) -> Decimal: 
    """Rs 0.50/L on ALL litres only if total_litres > 500.""" 
    if total_litres > BONUS_THRESHOLD: 
        return (total_litres * BONUS_PER_LITRE).quantize(Decimal("0.01"), 
rounding=ROUND_HALF_UP) 
    return Decimal("0.00") 
 
def farmer_ten_day_payout(entries: list, month: int) -> dict: 
    """Computes base payout, volume bonus, and grand total for one farmer.""" 
    total_litres = Decimal("0.0") 
    base_total = Decimal("0.00") 
    for litres, fat, snf in entries: 
        l_dec = Decimal(str(litres)) 
        rate = rate_per_litre_v2(fat, snf, month) 
        pay = (l_dec * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) 
        total_litres += l_dec 
        base_total += pay 
    bonus = ten_day_bonus(total_litres) 
    return {"litres": total_litres, "base": base_total, "bonus": bonus, "grand_total": 
base_total + bonus} 
 
