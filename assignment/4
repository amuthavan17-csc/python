def read_records(path): 
    records = [] 
    with open(path, "r", encoding="utf-8") as f: 
        for line in f: 
            if line.strip(): 
                reg, date_str, status = [x.strip() for x in line.split(",")] 
                records.append((reg, date_str, status)) 
    return records 
 
def compute_percentages(records): 
    totals = {} 
    for reg, _, status in records: 
        p, t = totals.get(reg, (0, 0)) 
        totals[reg] = (p + (1 if status == "P" else 0), t + 1) 
    return {reg: round((p / t) * 100, 2) for reg, (p, t) in totals.items()} 
 
def write_report(percentages, out_path): 
    with open(out_path, "w", encoding="utf-8") as f: 
        for reg, pct in sorted(percentages.items()): 
            f.write(f"{reg}: {pct:.2f}%\n") 
 
