def normalise(text):
    """'tn 09 ab 1234' -> 'TN09AB1234' (spaces and hyphens removed, upper case)."""
    return text.replace(" ", "").replace("-", "").upper()
def is_valid(reg):
    """Valid form: 2 letters, 2 digits, 1 or 2 letters, 4 digits (e.g. TN09AB1234)."""
    if len(reg) not in (9, 10):
        return False
    return (
        reg[:2].isalpha() and
        reg[2:4].isdigit() and
        reg[4:-4].isalpha() and
        reg[-4:].isdigit()
    )
def format_receipt(reg):
    """Formats a valid normalised registration string as 'TN 09 AB 1234'."""
    if not is_valid(reg):
        return "INVALID"
    return f"{reg[:2]} {reg[2:4]} {reg[4:-4]} {reg[-4:]}"
