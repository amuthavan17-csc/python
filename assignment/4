def find_consecutive_absences(records, streak=3): 
    by_student = {} 
    for reg, date_str, status in records: 
        by_student.setdefault(reg, []).append((date_str, status)) 
    flagged = [] 
    for reg, entries in by_student.items(): 
        consec = 0 
        for _, status in sorted(entries): 
            consec = consec + 1 if status == "A" else 0 
            if consec >= streak: 
                flagged.append(reg) 
                break 
    return sorted(flagged) 
 
