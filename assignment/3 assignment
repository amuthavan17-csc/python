# 3. 7-day moving average (Running-Sum O(n) approach) 
def moving_avg_running(data, k=7): 
    if len(data) < k: 
        return [] 
    window_sum = sum(data[:k]) 
    averages = [round(window_sum / k, 2)] 
    for i in range(k, len(data)): 
        window_sum += data[i] - data[i - k] 
        averages.append(round(window_sum / k, 2)) 
    return averages 
 
